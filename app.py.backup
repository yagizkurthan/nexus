from flask import Flask, render_template, request, jsonify, session
import os
from dotenv import load_dotenv
import pandas as pd
import sqlite3

load_dotenv()
from datetime import datetime
import google.generativeai as genai
import json
from db_manager import list_databases, create_database, list_tables, execute_sql, replace_table

app = Flask(__name__)
app.secret_key = os.urandom(24)

# Configure Gemini
GOOGLE_API_KEY = os.getenv('GOOGLE_API_KEY')
if not GOOGLE_API_KEY:
    # Fallback for dev if not set, though it should be
    print("Warning: GOOGLE_API_KEY not set.")

if GOOGLE_API_KEY:
    genai.configure(api_key=GOOGLE_API_KEY)

# Model configuration
generation_config = {
    "temperature": 0.2, # Lower temperature for more deterministic SQL
    "top_p": 0.95,
    "top_k": 40,
    "max_output_tokens": 8192,
}

model = genai.GenerativeModel(
    model_name="gemini-2.0-flash-exp",
    generation_config=generation_config,
    system_instruction="""You are an expert Data Analyst and SQL wizard. 
    Your goal is to help users analyze their data stored in SQLite databases.
    
    When a user asks a question:
    1. If it requires data, generate a valid SQLite SQL query to answer it. 
       Return ONLY the SQL query in a code block like ```sql ... ```.
       Assume the table names are available in the context or generic.
    2. If the user provides data results, interpret them and give a concise, insightful answer.
    
    Always be helpful, professional, and concise.
    """
)

@app.route('/')
