            res = execute_sql(db_name, f"SELECT * FROM \"{table}\" LIMIT 1")
            if 'columns' in res:
                schema_info[table] = res['columns']
        
        prompt = f"""
        Analyze this database schema: {json.dumps(schema_info)}
        
        Provide a summary of what this data represents and suggest 3 interesting questions the user could ask.
        Return as JSON:
        {{
            "summary": "...",
            "suggested_questions": ["Q1", "Q2", "Q3"]
        }}
        """
        
        response = model.generate_content(prompt)
        clean_text = response.text.replace('```json', '').replace('```', '').strip()
        return jsonify(json.loads(clean_text))
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/api/preview/<db_name>/<table_name>', methods=['GET'])
def preview_table(db_name, table_name):
    try:
        # Get schema info (columns)
        res = execute_sql(db_name, f"PRAGMA table_info(\"{table_name}\")")
        columns = []
        if 'rows' in res:
            columns = [r['name'] for r in res['rows']]
            
        # Get data
        data_res = execute_sql(db_name, f"SELECT * FROM \"{table_name}\" LIMIT 100")
        
        return jsonify({
            "columns": columns,
            "rows": data_res.get('rows', [])
        })
    except Exception as e:
        return jsonify({'error': str(e)}), 500

@app.route('/api/upload_csv', methods=['POST'])
def upload_csv():
    try:
        if 'file' not in request.files:
            return jsonify({'error': 'No file part'}), 400
        file = request.files['file']
        if file.filename == '':
            return jsonify({'error': 'No selected file'}), 400
        
        db_name = request.form.get('db_name', 'default')
        table_name = request.form.get('table_name', file.filename.split('.')[0])
        
        # Try to read CSV with error handling
        try:
            # First attempt: standard read
            df = pd.read_csv(file)
        except pd.errors.ParserError as pe:
            # Reset file pointer
            file.seek(0)
            try:
                # Second attempt: skip bad lines
                df = pd.read_csv(file, on_bad_lines='skip')
                print(f"Warning: Skipped some malformed lines in {file.filename}")
            except Exception:
                # Third attempt: with error_bad_lines=False for older pandas
                file.seek(0)
                try:
                    df = pd.read_csv(file, error_bad_lines=False)
                except Exception:
                    return jsonify({
                        'error': 'CSV parsing failed. The file has inconsistent columns or malformed data. Try cleaning your CSV file first.',
                        'details': str(pe)
                    }), 400
        except UnicodeDecodeError:
            # Try different encoding
            file.seek(0)
            try:
                df = pd.read_csv(file, encoding='latin1')
            except Exception as e:
                return jsonify({'error': f'Encoding error: {str(e)}'}), 400
        
        # Clean column names (remove leading/trailing spaces)
        df.columns = df.columns.str.strip()
        
        # Remove completely empty rows
        df = df.dropna(how='all')
        
        # Convert to list of dicts for db_manager
        columns = list(df.columns)
        rows = df.to_dict('records')
        
        # Save to DB
        create_database(db_name) # Ensure DB exists
        res = replace_table(db_name, table_name, columns, rows)
        
        if 'error' in res:
            return jsonify({'error': res['error']}), 500
        
        return jsonify({
            'status': 'success', 
            'rows': len(rows), 
            'columns': len(columns),
            'table': table_name,
            'message': f'Successfully uploaded {len(rows)} rows with {len(columns)} columns'
        })
    except Exception as e:
        print(f"Upload error: {str(e)}")
        return jsonify({'error': f'Upload failed: {str(e)}'}), 500

